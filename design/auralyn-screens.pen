                                  "fontSize": 13,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "sn7AZ",
                                  "name": "状態と送り先を確認し、「歌」「雑談」で登録した調整を切り替えます。「操作をロック",
                                  "context": "p",
                                  "fill": "#acb0b9",
                                  "content": "状態と送り先を確認し、「歌」「雑談」で登録した調整を切り替えます。「操作をロック」で意図しない変更を防ぎます。",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Segoe UI Variable Text",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "Gngck",
                              "name": "div",
                              "context": "div",
                              "width": "fill_container",
                              "height": 46.25,
                              "layout": "vertical",
                              "gap": 4,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "VHPYM",
                                  "name": "声と出力のメーター",
                                  "context": "h3",
                                  "fill": "#edeff3",
                                  "content": "声と出力のメーター",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Segoe UI Variable Text",
                                  "fontSize": 13,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "e4i0A",
                                  "name": "「声」は入ってきた音、「出力」は処理後に出す音の大きさです。メーターが動いても、",
                                  "context": "p",
                                  "fill": "#acb0b9",
                                  "content": "「声」は入ってきた音、「出力」は処理後に出す音の大きさです。メーターが動いても、相手に届いたことまでは確認できません。",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Segoe UI Variable Text",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "r6sZiK",
                              "name": "div",
                              "context": "div",
                              "width": "fill_container",
                              "height": 67.38,
                              "layout": "vertical",
                              "gap": 4,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "LH5Cj",
                                  "name": "音調整",
                                  "context": "h3",
                                  "fill": "#edeff3",
                                  "content": "音調整",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Segoe UI Variable Text",
                                  "fontSize": 13,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "A0UyCj",
                                  "name": "「ノイズ低減」はファン・空調などの持続ノイズ向けで、会話やBGMは完全には消えま",
                                  "context": "p",
                                  "fill": "#acb0b9",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 42.25,
                                  "content": "「ノイズ低減」はファン・空調などの持続ノイズ向けで、会話やBGMは完全には消えません。「声を整える」やVSTで声を調整し、ボイスチェックで聴いて確かめます。",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Segoe UI Variable Text",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "q48sJ",
                              "name": "div",
                              "context": "div",
                              "width": "fill_container",
                              "height": 46.25,
                              "layout": "vertical",
                              "gap": 3.99,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "LU9Hl",
                                  "name": "音声チェック",
                                  "context": "h3",
                                  "fill": "#edeff3",
                                  "content": "音声チェック",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Segoe UI Variable Text",
                                  "fontSize": 13,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "me3Ls",
                                  "name": "「音声チェック」で接続や送り先の確認へ進めます。自分で聴く確認と、配信・通話側で",
                                  "context": "p",
                                  "fill": "#acb0b9",
                                  "content": "「音声チェック」で接続や送り先の確認へ進めます。自分で聴く確認と、配信・通話側で届くことの確認は別です。",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Segoe UI Variable Text",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "Q9wl4",
                              "name": "div",
