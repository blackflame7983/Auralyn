                              "children": [
                                {
                                  "type": "text",
                                  "id": "KVjlb",
                                  "name": "フッターと緊急操作",
                                  "context": "h3",
                                  "fill": "#edeff3",
                                  "content": "フッターと緊急操作",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Segoe UI Variable Text",
                                  "fontSize": 13,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "wlQoZ",
                                  "name": "フッターの「VSTを外して比較」は外部VSTだけを外して比較し、ノイズ低減・声を",
                                  "context": "p",
                                  "fill": "#acb0b9",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 42.25,
                                  "content": "フッターの「VSTを外して比較」は外部VSTだけを外して比較し、ノイズ低減・声を整える機能は継続します。「出力音量」で大きさを調整し、すぐに声を止めたいときはヘッダーの「緊急ミュート」を使います。",
                                  "lineHeight": 1.63,
                                  "fontFamily": "Segoe UI Variable Text",
                                  "fontSize": 13,
                                  "fontWeight": "normal"
                                }
                              ]
