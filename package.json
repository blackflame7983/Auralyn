{
  "name": "auralyn",
  "private": true,
  "version": "1.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/prepare-sidecar.js && node scripts/generate-nsis-bitmaps.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "mcp:tauri": "npx -y @hypothesi/tauri-mcp-server",
    "gen-cargo-licenses": "cd src-tauri && cargo about generate --locked --fail about.hbs -o ../src/assets/licenses-cargo.json",
    "rebuild-engine": "node scripts/rebuild-engine.js",
    "release:check": "node scripts/check-release-readiness.cjs",
    "release:source": "node scripts/generate-source-archive.cjs",
    "release:upload": "node scripts/upload-release-to-public-repo.cjs",
    "test": "vitest",
    "test:release": "node --test scripts/*.test.cjs",
    "set-version": "node scripts/set-version.cjs",
    "test:unit": "vitest --run --project unit",
    "test:dom": "vitest --run --project dom",
    "test:e2e": "playwright test",
    "test:e2e:native": "node scripts/test-native-e2e.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.23",
    "bmp-ts": "1.0.9",
    "jsdom": "^27.4.0",
    "license-checker": "^25.0.1",
    "postcss": "^8.5.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
